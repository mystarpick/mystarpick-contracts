# Copy to .env and fill in. NEVER commit the real .env file.

# Deployer key used by `forge script ... --broadcast`.
# Provide via `--private-key $DEPLOYER_KEY` or a keystore/hardware wallet.
# Leave as a placeholder here; put the real value only in your local .env.
DEPLOYER_KEY=your_deployer_private_key_here

# Role assignments for MSPToken. If unset (or 0x0), the deployer address is used.
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
MINTER_ADDRESS=0x0000000000000000000000000000000000000000

# Blockscout verification. GIWA's Blockscout does not require a real key;
# any non-empty placeholder works.
GIWA_SCAN_API_KEY=placeholder
